# ============================================================
# MagicCars Support MVP — Environment Variables
# Copy this file to .env.local and fill in your values.
# ============================================================

# Required: Public base URL for generating upload links
APP_BASE_URL=http://localhost:3000

# Optional: OpenAI API key for real vision analysis.
# If not set, the app uses deterministic demo analysis.
OPENAI_API_KEY=

# OpenAI model to use for vision analysis
OPENAI_MODEL=gpt-4o-mini

# Optional: Retell API key (for outbound SMS via Retell)
RETELL_API_KEY=

# Optional: Retell webhook secret for signature verification (production)
RETELL_WEBHOOK_SECRET=

# Optional: Twilio credentials for SMS fallback
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Database path (leave as default for local JSON file)
DATABASE_URL=./data/db.json

# Storage mode: "local" for demo, "s3" for production
STORAGE_MODE=local
